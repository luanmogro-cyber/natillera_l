DB_PORT=3306
DB_NAME=natillera_l
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# Notificaciones Push (VAPID)
NATILLERA_VAPID_SUBJECT="mailto:admin@tu-dominio.com"
NATILLERA_VAPID_PUBLIC_KEY=
NATILLERA_VAPID_PRIVATE_KEY=

# Windows/Laragon: define OPENSSL_CONF en las variables de entorno de Windows
